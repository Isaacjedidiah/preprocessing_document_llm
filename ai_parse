# ========== CROP FIGURES (v2.0) — type-aware expansion for legend/heading ==========
import json
from PIL import Image

# --- CONFIG ---
DOC_PATH  = submissions[0]["path"]
IMG_OUT   = "/Volumes/<catalog>/<schema>/<volume>/rendered_pages"
CROP_OUT  = "/Volumes/<catalog>/<schema>/<volume>/crop_test"
dbutils.fs.mkdirs(CROP_OUT)

# --- 1. parse with version 2.0 (renders pages to IMG_OUT) ---
spark.read.format("binaryFile").load(DOC_PATH).createOrReplaceTempView("_crop_test")
raw = spark.sql(f"""
    SELECT ai_parse_document(content, map('version','2.0','imageOutputPath','{IMG_OUT}')) AS parsed
    FROM _crop_test
""").collect()[0]["parsed"]

d = json.loads(raw.toJson()) if hasattr(raw, "toJson") else (
    json.loads(raw) if isinstance(raw, str) else raw)
doc = d.get("document", d)
elements = doc.get("elements", [])
pages = d.get("pages") or doc.get("pages") or []

# --- 2. map page_id -> image_uri ---
page_uri = {}
for pg in pages:
    if isinstance(pg, dict):
        pid = pg.get("id") if pg.get("id") is not None else pg.get("page_id")
        uri = pg.get("image_uri")
        if pid is not None and uri:
            page_uri[pid] = uri

def _norm(p):
    return p.replace("dbfs:/Volumes", "/Volumes").replace("dbfs:", "/dbfs") if p else p

figs = [e for e in elements if e.get("type") == "figure"]
print(f"figures: {len(figs)}, pages: {sorted(page_uri.keys())}\n")

# --- 3. crop each figure with type-aware expansion ---
for i, f in enumerate(figs):
    bb = f.get("bbox")
    if not bb or not isinstance(bb, list) or not isinstance(bb[0], dict):
        print(f"figure {i}: no bbox"); continue
    b0 = bb[0]
    page_id = b0.get("page_id")
    coord = b0.get("coord")
    if not coord or len(coord) < 4:
        print(f"figure {i}: no coord -> {b0}"); continue

    uri = page_uri.get(page_id)
    if not uri:
        print(f"figure {i}: page {page_id} not in uri map"); continue

    try:
        img = Image.open(_norm(uri)).convert("RGB")
        iw, ih = img.size
        fx0, fy0, fx1, fy1 = coord[0], coord[1], coord[2], coord[3]

        # collect OTHER elements' coords AND type on the SAME page
        others = []
        for oe in elements:
            if oe is f:
                continue
            obb = oe.get("bbox")
            if obb and isinstance(obb, list) and isinstance(obb[0], dict):
                ob0 = obb[0]
                if ob0.get("page_id") == page_id:
                    oc = ob0.get("coord")
                    if oc and len(oc) >= 4:
                        others.append((oc, oe.get("type")))

        MAX_PAD = 200
        chart_area = (fx1 - fx0) * (fy1 - fy0)
        top, bottom = fy0, fy1
        left, right = fx0, fx1

        # PASS 1: include small NON-figure elements (legend/heading) near the chart
        for oc, otype in others:
            ox0, oy0, ox1, oy1 = oc[0], oc[1], oc[2], oc[3]
            area = (ox1 - ox0) * (oy1 - oy0)
            is_small = area < chart_area * 0.5
            if not is_small or otype == "figure":     # skip large OR any figure
                continue
            horiz_overlap = not (ox1 < fx0 or ox0 > fx1)
            vert_overlap  = not (oy1 < fy0 or oy0 > fy1)
            if oy1 <= fy0 and horiz_overlap and (fy0 - oy0) <= MAX_PAD:
                top = min(top, oy0 - 5)          # heading above
            if oy0 >= fy1 and horiz_overlap and (oy1 - fy1) <= MAX_PAD:
                bottom = max(bottom, oy1 + 5)    # legend below
            if ox0 >= fx1 and vert_overlap and (ox1 - fx1) <= MAX_PAD:
                right = max(right, ox1 + 5)      # legend right
            if ox1 <= fx0 and vert_overlap and (fx0 - ox0) <= MAX_PAD:
                left = min(left, ox0 - 5)        # legend left

        # PASS 2: clip so the crop NEVER crosses into another FIGURE (chart)
        for oc, otype in others:
            if otype != "figure":
                continue
            ox0, oy0, ox1, oy1 = oc[0], oc[1], oc[2], oc[3]
            horiz_overlap = not (ox1 < fx0 or ox0 > fx1)
            vert_overlap  = not (oy1 < fy0 or oy0 > fy1)
            if oy1 <= fy0 and horiz_overlap:
                top = max(top, oy1 + 5)
            if oy0 >= fy1 and horiz_overlap:
                bottom = min(bottom, oy0 - 5)
            if ox1 <= fx0 and vert_overlap:
                left = max(left, ox1 + 5)
            if ox0 >= fx1 and vert_overlap:
                right = min(right, ox0 - 5)

        # clamp to image bounds + safety fallback
        x0, y0 = max(0, int(left)), max(0, int(top))
        x1, y1 = min(iw, int(right)), min(ih, int(bottom))
        if x1 <= x0 or y1 <= y0:
            x0, y0, x1, y1 = max(0,int(fx0)), max(0,int(fy0)), min(iw,int(fx1)), min(ih,int(fy1))

        crop = img.crop((x0, y0, x1, y1))
        out = f"{CROP_OUT}/figure_{i}_page{page_id}.png"
        crop.save(_norm(out))
        print(f"figure {i}: page={page_id} chart={coord} crop=[{x0},{y0},{x1},{y1}] "
              f"saved {crop.size[0]}x{crop.size[1]}")

    except Exception as e:
        print(f"figure {i}: ERROR {e}")

print(f"\nsaved to: {CROP_OUT}")
print(">>> Check: each chart cropped ONCE, with its legend/heading, NO other chart included.")

# seventh
# ========== CROP FIGURES (v2.0) — sequence-adjacency by type (header/legend) ==========
import json
from PIL import Image

# --- CONFIG ---
DOC_PATH  = submissions[0]["path"]
IMG_OUT   = "/Volumes/<catalog>/<schema>/<volume>/rendered_pages"
CROP_OUT  = "/Volumes/<catalog>/<schema>/<volume>/crop_test"
dbutils.fs.mkdirs(CROP_OUT)

# --- 1. parse with version 2.0 (renders pages to IMG_OUT) ---
spark.read.format("binaryFile").load(DOC_PATH).createOrReplaceTempView("_crop_test")
raw = spark.sql(f"""
    SELECT ai_parse_document(content, map('version','2.0','imageOutputPath','{IMG_OUT}')) AS parsed
    FROM _crop_test
""").collect()[0]["parsed"]

d = json.loads(raw.toJson()) if hasattr(raw, "toJson") else (
    json.loads(raw) if isinstance(raw, str) else raw)
doc = d.get("document", d)
elements = doc.get("elements", [])
pages = d.get("pages") or doc.get("pages") or []

# --- 2. map page_id -> image_uri ---
page_uri = {}
for pg in pages:
    if isinstance(pg, dict):
        pid = pg.get("id") if pg.get("id") is not None else pg.get("page_id")
        uri = pg.get("image_uri")
        if pid is not None and uri:
            page_uri[pid] = uri

def _norm(p):
    return p.replace("dbfs:/Volumes", "/Volumes").replace("dbfs:", "/dbfs") if p else p

figs = [e for e in elements if e.get("type") == "figure"]
print(f"figures: {len(figs)}, pages: {sorted(page_uri.keys())}\n")

# --- 3. crop each figure: chart + header (section_header before) + legend (footnote after) ---
for i, f in enumerate(figs):
    bb = f.get("bbox")
    if not bb or not isinstance(bb, list) or not isinstance(bb[0], dict):
        print(f"figure {i}: no bbox"); continue
    b0 = bb[0]
    page_id = b0.get("page_id")
    coord = b0.get("coord")
    if not coord or len(coord) < 4:
        print(f"figure {i}: no coord -> {b0}"); continue

    uri = page_uri.get(page_id)
    if not uri:
        print(f"figure {i}: page {page_id} not in uri map"); continue

    try:
        img = Image.open(_norm(uri)).convert("RGB")
        iw, ih = img.size
        fx0, fy0, fx1, fy1 = coord[0], coord[1], coord[2], coord[3]

        # --- SEQUENCE-ADJACENCY by TYPE: ai_parse labels a chart's HEADER as
        #     'section_header' (element before) and its LEGEND as 'footnote'
        #     (element after). Merge those types around the figure. Never merge
        #     table/figure. ---
        fig_idx = elements.index(f)
        _HEADER_TYPES = {"section_header", "title", "caption"}
        _LEGEND_TYPES = {"footnote", "caption", "legend"}
        _NEVER        = {"table", "figure"}
        top, bottom = fy0, fy1
        left, right = fx0, fx1

        def _merge(idx, allowed_types):
            nonlocal top, bottom, left, right
            if idx < 0 or idx >= len(elements) or idx == fig_idx:
                return
            e = elements[idx]
            etype = str(e.get("type", "")).lower()
            if etype in _NEVER or etype not in allowed_types:
                return
            eb = e.get("bbox")
            if not eb or not isinstance(eb[0], dict) or eb[0].get("page_id") != page_id:
                return
            c = eb[0].get("coord")
            if not c or len(c) < 4:
                return
            cx0, cy0, cx1, cy1 = c
            # only merge if aligned with the chart (shares its column or row)
            if not (cx1 < fx0 or cx0 > fx1) or not (cy1 < fy0 or cy0 > fy1):
                top = min(top, cy0); bottom = max(bottom, cy1)
                left = min(left, cx0); right = max(right, cx1)

        # HEADER: elements BEFORE the figure
        _merge(fig_idx - 1, _HEADER_TYPES)
        _merge(fig_idx - 2, _HEADER_TYPES)
        # LEGEND: elements AFTER the figure
        _merge(fig_idx + 1, _LEGEND_TYPES)
        _merge(fig_idx + 2, _LEGEND_TYPES)

        # clip so the crop NEVER crosses into another FIGURE
        for oe in elements:
            if oe is f or str(oe.get("type", "")).lower() != "figure":
                continue
            obb = oe.get("bbox")
            if not obb or not isinstance(obb[0], dict) or obb[0].get("page_id") != page_id:
                continue
            oc = obb[0].get("coord")
            if not oc or len(oc) < 4:
                continue
            ox0, oy0, ox1, oy1 = oc
            h = not (ox1 < fx0 or ox0 > fx1)
            v = not (oy1 < fy0 or oy0 > fy1)
            if oy1 <= fy0 and h: top = max(top, oy1 + 5)
            if oy0 >= fy1 and h: bottom = min(bottom, oy0 - 5)
            if ox1 <= fx0 and v: left = max(left, ox1 + 5)
            if ox0 >= fx1 and v: right = min(right, ox0 - 5)

        # clamp + safety fallback
        x0, y0 = max(0, int(left)), max(0, int(top))
        x1, y1 = min(iw, int(right)), min(ih, int(bottom))
        if x1 <= x0 or y1 <= y0:
            x0, y0, x1, y1 = max(0,int(fx0)), max(0,int(fy0)), min(iw,int(fx1)), min(ih,int(fy1))

        crop = img.crop((x0, y0, x1, y1))
        out = f"{CROP_OUT}/figure_{i}_page{page_id}.png"
        crop.save(_norm(out))
        print(f"figure {i}: page={page_id} chart={coord} crop=[{x0},{y0},{x1},{y1}] "
              f"saved {crop.size[0]}x{crop.size[1]}")

    except Exception as e:
        print(f"figure {i}: ERROR {e}")

print(f"\nsaved to: {CROP_OUT}")
print(">>> Check: each crop = chart + header (section_header) + legend (footnote),")
print(">>> cropped once, no other chart included.")
